[Unit]
Description=PCEP isolated PostgreSQL restore verification
Requires=docker.service
After=docker.service
ConditionPathIsDirectory=/home/micu/PCEP_webApp
ConditionPathIsDirectory=/home/micu/backups/pcep/daily

[Service]
Type=oneshot
User=micu
Group=micu
UMask=0077
WorkingDirectory=/home/micu/PCEP_webApp
StateDirectory=pcep-db-restore-check
StateDirectoryMode=0700
ExecStart=/home/micu/PCEP_webApp/backend/.venv/bin/python /home/micu/PCEP_webApp/scripts/database_restore_check.py --backup-root /home/micu/backups/pcep/daily --source-container pcep_db --restore-container pcep_db_restore_check --fallback-image pcep_webapp-postgres:16.15-alpine3.24 --status-file /var/lib/pcep-db-restore-check/last-success.json

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/micu/backups/pcep/daily
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=256M
TasksMax=64
TimeoutStartSec=15m
