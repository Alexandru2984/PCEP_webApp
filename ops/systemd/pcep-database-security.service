[Unit]
Description=Verify PCEP PostgreSQL least-privilege role boundaries
Requires=docker.service
After=docker.service
ConditionPathIsDirectory=/home/micu/PCEP_webApp

[Service]
Type=oneshot
User=micu
Group=micu
UMask=0077
WorkingDirectory=/home/micu/PCEP_webApp
StateDirectory=pcep-db-security
StateDirectoryMode=0700
ExecStart=/home/micu/PCEP_webApp/backend/.venv/bin/python /home/micu/PCEP_webApp/scripts/database_security_check.py --status-file /var/lib/pcep-db-security/last-success.json --container pcep_db

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=128M
TasksMax=32
TimeoutStartSec=2m
