[Unit]
Description=PCEP atomic public study-page generation
Documentation=file:/usr/local/sbin/pcep-seo-pages
Requires=docker.service
After=docker.service
ConditionFileIsExecutable=/usr/local/sbin/pcep-seo-pages
ConditionPathExists=/var/run/docker.sock
ConditionPathIsDirectory=/var/www/pcep

[Service]
Type=oneshot
User=micu
Group=micu
UMask=0022
WorkingDirectory=/
ExecStart=/usr/bin/python3 /usr/local/sbin/pcep-seo-pages

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/pcep
ReadOnlyPaths=/var/run/docker.sock
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=128M
TasksMax=64
TimeoutStartSec=5m
