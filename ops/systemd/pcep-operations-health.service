[Unit]
Description=Publish minimal PCEP recovery and database security health
After=pcep-db-backup.service pcep-db-restore-check.service pcep-database-security.service
ConditionPathIsDirectory=/home/micu/PCEP_webApp
ConditionPathIsDirectory=/home/micu/backups/pcep/daily

[Service]
Type=oneshot
User=micu
Group=www-data
UMask=0077
WorkingDirectory=/home/micu/PCEP_webApp
StateDirectory=pcep-operations-health
StateDirectoryMode=0750
ExecStart=/home/micu/PCEP_webApp/backend/.venv/bin/python /home/micu/PCEP_webApp/scripts/operations_health.py --backup-root /home/micu/backups/pcep/daily --backup-job-status /var/lib/pcep-db-backup/last-success.json --backup-job-max-age-hours 26 --restore-status /var/lib/pcep-db-restore-check/last-success.json --output /var/lib/pcep-operations-health/status.json --backup-max-age-hours 26 --restore-max-age-hours 170 --offsite-status /var/lib/pcep-db-offsite/last-success --offsite-required-after 2026-10-27 --offsite-max-age-hours 24 --database-security-status /var/lib/pcep-db-security/last-success.json --database-security-max-age-hours 2 --release-root /var/www/pcep --release-staging-max-age-hours 2 --deployment-backup-root /home/micu/backups/pcep --deployment-backup-temporary-max-age-hours 2 --release-snapshot-maximum 10 --release-snapshot-max-allocated-mib 512 --verify-installation --verify-nginx-installation --verify-container-runtime
ExecStartPost=/usr/bin/setfacl --modify user:www-data:r-- /var/lib/pcep-operations-health/status.json
ExecStopPost=-/usr/bin/setfacl --modify user:www-data:r-- /var/lib/pcep-operations-health/status.json

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/micu/backups/pcep/daily
ReadOnlyPaths=/home/micu/backups/pcep
ReadOnlyPaths=/var/lib/pcep-db-backup
ReadOnlyPaths=/var/lib/pcep-db-restore-check
ReadOnlyPaths=/var/lib/pcep-db-security
ReadOnlyPaths=-/var/lib/pcep-db-offsite
ReadOnlyPaths=/var/www/pcep
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=128M
TasksMax=32
TimeoutStartSec=2m
