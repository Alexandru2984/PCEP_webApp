[Unit]
Description=Publish minimal PCEP backup and restore health
After=pcep-db-backup.service pcep-db-restore-check.service
ConditionPathIsDirectory=/home/micu/PCEP_webApp
ConditionPathIsDirectory=/home/micu/backups/pcep/daily

[Service]
Type=oneshot
User=micu
Group=www-data
UMask=0027
WorkingDirectory=/home/micu/PCEP_webApp
StateDirectory=pcep-operations-health
StateDirectoryMode=0750
ExecStart=/home/micu/PCEP_webApp/backend/.venv/bin/python /home/micu/PCEP_webApp/scripts/operations_health.py --backup-root /home/micu/backups/pcep/daily --restore-status /var/lib/pcep-db-restore-check/last-success.json --output /var/lib/pcep-operations-health/status.json --backup-max-age-hours 26 --restore-max-age-hours 170
ExecStartPost=/usr/bin/setfacl --modify user:www-data:r-- /var/lib/pcep-operations-health/status.json
ExecStopPost=-/usr/bin/setfacl --modify user:www-data:r-- /var/lib/pcep-operations-health/status.json

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/micu/backups/pcep/daily
ReadOnlyPaths=/var/lib/pcep-db-restore-check
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=32
TimeoutStartSec=2m
