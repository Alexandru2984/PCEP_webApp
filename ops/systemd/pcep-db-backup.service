[Unit]
Description=PCEP verified PostgreSQL backup
Requires=docker.service
After=docker.service
ConditionPathIsDirectory=/home/micu/PCEP_webApp

[Service]
Type=oneshot
User=micu
Group=micu
UMask=0077
WorkingDirectory=/home/micu/PCEP_webApp
ExecStart=/home/micu/PCEP_webApp/backend/.venv/bin/python /home/micu/PCEP_webApp/scripts/database_backup.py --backup-root /home/micu/backups/pcep/daily --container pcep_db --keep 30

NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/micu/backups/pcep/daily
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=64
TimeoutStartSec=5m
