# --- PostgreSQL ---
POSTGRES_DB=pcep_db
POSTGRES_USER=pcep_user
POSTGRES_PASSWORD=change_me_to_strong_password

# --- Django ---
DJANGO_SECRET_KEY=change_me_to_random_50_char_secret
DJANGO_DEBUG=False
# Production: list only the real public hostname(s). Add localhost,127.0.0.1
# only when needed for local development; Docker healthchecks use the configured hostname.
DJANGO_ALLOWED_HOSTS=pcep.micutu.com

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ALLOWED_ORIGINS=https://pcep.micutu.com

# Optional startup deadline (1..300 seconds); backend DB connections wait at most 5s.
DB_STARTUP_TIMEOUT_SECONDS=60
# Persistent PostgreSQL connection lifetime in seconds.
POSTGRES_CONN_MAX_AGE=60
