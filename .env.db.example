# PostgreSQL container bootstrap/admin credentials. Keep this file separate from
# `.env`: Django must never receive the administrator password.
POSTGRES_DB=pcep_db
POSTGRES_USER=pcep_admin
POSTGRES_PASSWORD=change_me_to_a_different_strong_admin_password

# Least-privilege Django role. These three values must match POSTGRES_DB,
# POSTGRES_USER and POSTGRES_PASSWORD in `.env`.
PCEP_APP_DB=pcep_db
PCEP_APP_USER=pcep_user
PCEP_APP_PASSWORD=change_me_to_strong_password
