{
  "name": "pcep-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "allowScripts": {
    "fsevents": false
  },
  "overrides": {
    "rolldown": "1.2.11",
    "workbox-build": {
      "glob": "13.0.6"
    }
  },
  "scripts": {
    "dev": "vite",
    "fetch-pyodide": "bash scripts/fetch-pyodide.sh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "axios": "1.20.0",
    "react": "^19.3.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.0.0",
    "vite": "8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
